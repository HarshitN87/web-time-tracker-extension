{
  "manifest_version": 3,
  "name": "Flow Tracker",
  "version": "4.0",
  "description": "Track where your browser time actually goes, entirely on your own machine. No account, no upload, no third-party requests.",
  "permissions": [
    "tabs",
    "storage",
    "notifications",
    "idle",
    "scripting"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Flow Tracker"
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "flow-tracker-unique-20260320@example.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
